---
/*
 * The page's closing band, and the only inverted surface on the site: ink
 * ground, off white type. Every page used to stop wherever its content did,
 * which read as unfinished rather than quiet.
 *
 * `cta` adds the invitation above the link rows. /contact turns it off: the
 * page above it is already that invitation.
 */
export interface Props {
  cta?: boolean
}
const { cta = true } = Astro.props

const email = 'hello@avp.software'

const site = [
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
]

const elsewhere = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/arthur-van-petegem-7b72b1323/' },
  { label: 'GitHub', href: 'https://github.com/VanPetegem' },
]

const year = new Date().getFullYear()
---
<footer class="site-footer">
  {cta && (
    <div class="footer-cta">
      <h2 class="footer-heading">
        Tell me about your team&rsquo;s most annoying Tuesday.
      </h2>
      <div class="footer-cta-side">
        <p class="footer-lead">
          Describe the workflow that costs you the most time. If I can help, I
          will tell you how. If I cannot, I will say so.
        </p>
        <a class="footer-email" href={`mailto:${email}`}>
          <span>{email}</span>
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 13L13 3M13 3H6M13 3V10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  )}

  <div class="footer-rows">
    <div class="footer-brand">
      <a class="footer-wordmark" href="/" aria-label="AVP Software, home">AVP Software</a>
      <p>
        A small studio that designs, builds and runs software for teams.
      </p>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <span class="footer-col-title">Site</span>
      <ul>
        {site.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-col">
      <span class="footer-col-title">Elsewhere</span>
      <ul>
        {!cta && <li><a href={`mailto:${email}`}>{email}</a></li>}
        {elsewhere.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer-base">
    <span>&copy; {year} AVP Software</span>
    <span>St. Gallen and Baden, Switzerland</span>
  </div>
</footer>

<style>
  .site-footer {
    --footer-x: clamp(1.5rem, 10vw, 10rem);

    position: relative;
    background: var(--color-ink);
    color: var(--color-bg);
    padding: 0 var(--footer-x) calc(2rem + env(safe-area-inset-bottom, 0px));
  }

  /* The site-wide selection is ink on off white, which is this band's own
     ground: selected text here would look unselected. */
  .site-footer ::selection {
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .site-footer a {
    transition: color 200ms;
  }

  .site-footer a:hover {
    color: var(--color-accent-on-ink);
  }

  .site-footer a:focus-visible {
    outline-color: var(--color-bg);
  }

  /* ---- Invitation ---- */
  .footer-cta {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    padding: clamp(5rem, 14vh, 9rem) 0 clamp(4rem, 10vh, 7rem);
    border-bottom: 1px solid var(--color-on-ink-border);
  }

  .footer-heading {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.2vw, 4.75rem);
    font-weight: 600;
    font-optical-sizing: none;
    letter-spacing: var(--tracking-display);
    line-height: 1.04;
    text-wrap: balance;
    max-width: 14ch;
  }

  .footer-lead {
    color: var(--color-on-ink-muted);
    line-height: 1.6;
    max-width: 38ch;
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    margin-top: 1.5rem;
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .footer-email span {
    padding-bottom: 0.2em;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 100% 1px;
  }

  .footer-email svg {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-email:hover svg {
    transform: translate(3px, -3px);
  }

  /* ---- Link rows ---- */
  .footer-rows {
    display: grid;
    grid-template-columns: 7fr 2.5fr 2.5fr;
    gap: clamp(2rem, 6vw, 6rem);
    padding: clamp(3rem, 7vh, 4.5rem) 0;
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    font-optical-sizing: none;
    letter-spacing: var(--tracking-display);
    line-height: 1.2;
  }

  .footer-brand p {
    margin-top: 0.75rem;
    max-width: 30ch;
    color: var(--color-on-ink-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .footer-col-title {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--color-on-ink-muted);
    font-size: 0.8125rem;
  }

  .footer-col ul {
    list-style: none;
  }

  /* inline-flex with a min-height so each link is a 36px row to a pointer and
     the list still reads as tight text. */
  .footer-col a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    font-size: 0.9375rem;
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-on-ink-border);
    color: var(--color-on-ink-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 767px) {
    .footer-cta {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .footer-rows {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-col a {
      min-height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-email svg {
      transition: none;
    }
  }
</style>
