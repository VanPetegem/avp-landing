---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="Not found | AVP Software">
  <main class="page-container">
    <span class="page-label">404</span>
    <h1 class="page-heading">This page went missing.</h1>
    <div class="page-body">
      <p>The link is broken or the page has moved. Nothing here to see.</p>
    </div>
    <a href="/" class="text-link">
      <span>Back to home</span>
      <span class="text-link-arrow" aria-hidden="true">&#8594;</span>
    </a>
  </main>
</BaseLayout>

