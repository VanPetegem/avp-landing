---
import BaseLayout from '../layouts/BaseLayout.astro'
import LogoMarquee from '../components/LogoMarquee.astro'
import FocusIcon from '../components/focus/FocusIcon.svelte'
---
<BaseLayout title="About | AVP Software">
  <main class="page-split">
    <header class="page-split-head">
      <span class="page-label">About</span>
      <h1 class="page-heading">Arthur Van Petegem</h1>
    </header>

    <div class="about-main">
      <p class="page-lead">
        Arthur Van Petegem is a software engineer and builder based in
        St.&nbsp;Gallen and Baden, Aargau. He builds precise, opinionated
        software, from volunteer coordination platforms to automating
        operations processes.
      </p>
      <p class="about-second">
        AVP Software is the studio through which that work ships. The focus is on
        craft over convention: software that is fast, considered, and owned by the
        people who use it.
      </p>

    <div class="about-focus">
      <span class="label">Focus</span>
      <ul>
        <li>
          <FocusIcon icon="layout-panel-left" delay={0} client:visible />
          Web platforms
        </li>
        <li>
          <FocusIcon icon="route" delay={80} client:visible />
          Process automations
        </li>
        <li>
          <FocusIcon icon="cpu" delay={160} client:visible />
          AI-assisted products
        </li>
      </ul>
    </div>
    </div>
  </main>
  <LogoMarquee />
</BaseLayout>

<style>
  /*
   * One heading for the list, not one per row: the word was the same on all
   * three and its fixed 4rem column plus the gap spent 88px of a phone's
   * width repeating it.
   */
  .about-second {
    margin-top: 1.5rem;
    max-width: 52ch;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .about-focus {
    margin-top: clamp(3rem, 8vh, 4.5rem);
  }

  .about-focus .label {
    display: block;
    margin-bottom: 0.75rem;
  }

  .about-focus ul {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  /*
   * The icon sits in its own column so a long label wraps against the text
   * column rather than under the glyph. `auto` rather than a fixed width: the
   * icon is 20px today and the column should follow it if that changes.
   */
  .about-focus li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink);
  }
</style>
