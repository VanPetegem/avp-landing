---
import BaseLayout from '../layouts/BaseLayout.astro'
import BigTypeRoll from '../components/BigTypeRoll'
import HeroKnot from '../components/HeroKnot.astro'
import { projects } from '../data/projects'

// A video project shows its poster here: the home page is a list of stills,
// and four autoplaying encodes would cost more than the section is worth.
const work = projects.slice(0, 4).map((project) => ({
  slug: project.slug,
  title: project.title,
  client: project.client,
  year: project.year,
  image: project.video?.poster ?? project.images[0],
}))

const steps = [
  {
    title: 'Map',
    body: 'I start inside the workflow: the spreadsheet someone updates by hand, the approval that lives in an inbox. The tool gets designed around how your team already works.',
  },
  {
    title: 'Design',
    body: 'Internal tools people actually want to open. Status visible at a glance, forms that adapt to the case, and no manual required to use any of it.',
  },
  {
    title: 'Build',
    body: 'Wired into the systems you already pay for: accounting, e-signing, email, webhooks. Work moves itself forward instead of waiting for someone to forward it.',
  },
  {
    title: 'Run',
    body: 'I host it, watch it, and keep automating. Every release after launch removes another manual step.',
  },
]

const faqs = [
  {
    q: 'What kind of projects do you take on?',
    a: 'Mostly internal tools and workflow automation: expense pipelines, approval flows, dashboards. The software your team uses every day but your customers never see. I also build customer facing products end to end when the fit is right.',
  },
  {
    q: 'Can you connect the tools we already use?',
    a: 'Yes, that is usually the whole point. Past projects have talked to accounting software, e-signature services, email, and plain webhooks. If it has an API, or even just an export button, it can join the workflow.',
  },
  {
    q: 'What does a project cost?',
    a: 'I quote a fixed price for a defined scope after we have mapped what the work involves. If the scope grows, we agree on a new price before I build more. You will never find the surprise on an invoice.',
  },
  {
    q: 'How long until something usable?',
    a: 'Weeks, not quarters. I ship a small working version early, your team uses it, and we improve from there.',
  },
  {
    q: 'How much of our time do you need?',
    a: 'A kickoff where I watch how the work is done today, then a short weekly check-in. The people doing the actual work teach me more than any requirements document.',
  },
  {
    q: 'Who runs it after launch?',
    a: 'I do. Hosting, monitoring, fixes, and further automation. If you want to take it in house later, you get the code and a proper handover.',
  },
  {
    q: 'How do we find out if it is a fit?',
    a: 'Send a message through the <a href="/contact">contact page</a> and describe the workflow that annoys you most. If I can help, I will tell you how. If I cannot, I will say so.',
  },
]

---
<BaseLayout title="AVP Software">
  <section class="hero">
    <HeroKnot />

    <div class="hero-content">
      <h1 class="hero-title">AVP Software</h1>
      <p class="hero-tagline">
        A small studio that designs and builds software end to end: interface,
        product, and the infrastructure underneath.
      </p>
      <div class="hero-actions">
        <a class="text-link" href="/contact">
          <span>Get in touch</span>
          <span class="text-link-arrow" aria-hidden="true">&#8594;</span>
        </a>
        <a class="text-link" data-quiet href="/work">
          <span>See the work</span>
        </a>
      </div>
    </div>
  </section>

  <section class="process" id="process">
    <header class="process-head" data-reveal>
      <span class="page-label">Process</span>
      <h2 class="process-heading">
        Most projects start with an idea. Mine start with your team&rsquo;s most
        annoying Tuesday.
      </h2>
      <div class="process-rail" data-process-rail aria-hidden="true">
        <span class="process-rail-fill"></span>
        <ol class="process-rail-steps">
          {steps.map((step) => (
            <li data-process-mark>{step.title}</li>
          ))}
        </ol>
      </div>
    </header>
    <ol class="process-steps" data-process-steps>
      {steps.map((step, i) => (
        <li
          class="process-step"
          data-reveal
          data-process-step
          data-active={i === 0 ? '' : undefined}
          style={`--reveal-delay: ${i * 80}ms`}
        >
          <span class="process-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="process-text">
            <h3 class="process-title">{step.title}</h3>
            <p class="process-body">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="work" aria-labelledby="work-heading">
    <header class="work-head" data-reveal>
      <h2 class="work-heading" id="work-heading">Selected work</h2>
      <a class="text-link" href="/work">
        <span>All work</span>
        <span class="text-link-arrow" aria-hidden="true">&#8594;</span>
      </a>
    </header>
    <ul class="work-grid">
      {work.map((item, i) => (
        <li class="work-item" data-reveal style={`--reveal-delay: ${(i % 2) * 90}ms`}>
          <a href={`/work/${item.slug}`}>
            <div class="work-frame">
              <img
                src={item.image}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="work-meta">
              <h3 class="work-title">{item.title}</h3>
              <span class="work-client">{item.client}, {item.year}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <div class="work-cursor" data-work-cursor aria-hidden="true">
      <span class="work-cursor-pill">
        View project
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
          <path d="M3 13L13 3M13 3H6M13 3V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </section>

  <section class="bigtype" aria-hidden="true">
    <div class="bigtype-line" data-speed="-0.35">
      <div class="bigtype-shift" data-bigtype-shift>
        <BigTypeRoll text="DESIGN BUILD" client:media="(hover: hover) and (pointer: fine)" />
      </div>
    </div>
    <div class="bigtype-line" data-speed="0.35">
      <div class="bigtype-shift" data-bigtype-shift>
        <BigTypeRoll text="AUTOMATE RUN" center client:media="(hover: hover) and (pointer: fine)" />
      </div>
    </div>
  </section>

  <section class="faq">
    <header class="faq-head" data-reveal>
      <h2 class="faq-heading">The questions clients ask first.</h2>
    </header>
    <div class="faq-list">
      {faqs.map((item, i) => (
        <details class="faq-item" name="faq" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
          <summary class="faq-question">
            <span>{item.q}</span>
            <svg class="faq-icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <rect x="0" y="6.25" width="14" height="1.5" rx="0.75" />
              <rect class="faq-icon-v" x="6.25" y="0" width="1.5" height="14" rx="0.75" />
            </svg>
          </summary>
          <div class="faq-answer">
            <p set:html={item.a} />
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import { calculateBigtypeShift } from '../scripts/bigtype-motion.mjs'
  import { getActiveStep, getRailProgress } from '../scripts/process-motion.mjs'

  /*
   * The process reads as a workflow moving forward. An anchor line at the
   * middle of the viewport walks down the steps: the rail under the sticky
   * heading fills with it and the step it is inside wakes its numeral.
   * Reduced motion keeps the information (which step, how far) and loses
   * only the transitions, which the stylesheet drops.
   */
  function armProcess() {
    const list = document.querySelector<HTMLElement>('[data-process-steps]')
    const rail = document.querySelector<HTMLElement>('[data-process-rail]')
    if (!list || !rail || list.dataset.armed) return
    // Set in the same task as the first update(), so no frame paints the
    // armed colours before the active step is known.
    list.dataset.armed = ''
    rail.dataset.armed = ''
    const steps = Array.from(list.querySelectorAll<HTMLElement>('[data-process-step]'))
    const marks = Array.from(rail.querySelectorAll<HTMLElement>('[data-process-mark]'))

    let active = -1
    let ticking = false
    const update = () => {
      ticking = false
      // A view transition swaps the page out; stop listening for a list that
      // is no longer in the document.
      if (!list.isConnected) {
        removeEventListener('scroll', onScroll)
        removeEventListener('resize', onScroll)
        return
      }
      const anchor = innerHeight / 2
      const tops = steps.map((step) => step.getBoundingClientRect().top)
      const end = list.getBoundingClientRect().bottom
      rail.style.setProperty('--process-progress', String(getRailProgress(tops, end, anchor)))
      const next = getActiveStep(tops, anchor)
      if (next === active) return
      active = next
      steps.forEach((step, i) => step.toggleAttribute('data-active', i === active))
      marks.forEach((mark, i) => mark.toggleAttribute('data-reached', i <= active))
    }
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(update)
    }
    addEventListener('scroll', onScroll, { passive: true })
    addEventListener('resize', onScroll, { passive: true })
    update()
    requestAnimationFrame(() => {
      list.dataset.live = ''
    })
  }

  /*
   * A pill that follows the pointer over a project and names what a click
   * does. Fine pointers only: on touch there is no hover to follow. It snaps
   * to the pointer on entry, so it never flies in from where it was last
   * left, then trails on a frame-rate independent ease so it reads as
   * attached rather than glued. Under reduced motion it tracks 1:1.
   */
  function armWorkCursor() {
    const pill = document.querySelector<HTMLElement>('[data-work-cursor]')
    if (!pill || pill.dataset.armed) return
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return
    pill.dataset.armed = ''
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    const links = document.querySelectorAll<HTMLElement>('.work-item a')

    const pos = { x: 0, y: 0 }
    const goal = { x: 0, y: 0 }
    let frame = 0
    let last = 0
    let shown = false
    let hiddenAt = -Infinity

    const paint = () => {
      pill.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`
    }
    const tick = (now: number) => {
      const dt = last ? Math.min(64, now - last) : 16
      last = now
      // Closes ~94% of the gap in 100ms whatever the refresh rate.
      const k = 1 - Math.exp(-dt / 36)
      pos.x += (goal.x - pos.x) * k
      pos.y += (goal.y - pos.y) * k
      paint()
      if (Math.abs(goal.x - pos.x) + Math.abs(goal.y - pos.y) > 0.3) {
        frame = requestAnimationFrame(tick)
      } else {
        frame = 0
        last = 0
      }
    }
    const follow = (event: PointerEvent) => {
      // A hybrid laptop's touchscreen still fires pointer events here; a tap
      // has no hover to follow and would strand the pill where it landed.
      if (event.pointerType !== 'mouse') return
      goal.x = event.clientX
      goal.y = event.clientY
      if (!shown || still) {
        pos.x = goal.x
        pos.y = goal.y
        paint()
        return
      }
      if (!frame) frame = requestAnimationFrame(tick)
    }

    links.forEach((link) => {
      link.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse') return
        // Crossing straight to the next tile catches the pill mid fade-out:
        // glide it over from where it is instead of snapping it there.
        if (performance.now() - hiddenAt < 150) shown = true
        follow(event)
        shown = true
        pill.toggleAttribute('data-visible', true)
      })
      link.addEventListener('pointermove', follow)
      link.addEventListener('pointerleave', () => {
        shown = false
        hiddenAt = performance.now()
        pill.toggleAttribute('data-visible', false)
      })
    })
  }

  function armBigtype() {
    const lines = Array.from(
      document.querySelectorAll<HTMLElement>('.bigtype-line')
    )
    if (!lines.length) return
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return

    let ticking = false
    const update = () => {
      ticking = false
      const vh = innerHeight
      for (const line of lines) {
        const rect = line.getBoundingClientRect()
        const lineCenter = rect.top + rect.height / 2
        const speed = parseFloat(line.dataset.speed || '0')
        const shiftTarget = line.querySelector<HTMLElement>('[data-bigtype-shift]')
        if (!shiftTarget) continue
        const shift = calculateBigtypeShift(
          lineCenter,
          vh,
          innerWidth,
          speed,
          shiftTarget.getBoundingClientRect().width
        )
        shiftTarget.style.setProperty('--shift', `${shift}px`)
      }
    }
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(update)
    }

    addEventListener('scroll', onScroll, { passive: true })
    // A resize changes the slack, so a shift parked from the last scroll can
    // outgrow it. Re-clamp on resize rather than wait for the next scroll.
    addEventListener('resize', onScroll, { passive: true })
    update()
  }

  function armHome() {
    armBigtype()
    armProcess()
    armWorkCursor()
  }

  armHome()
  document.addEventListener('astro:page-load', armHome)
</script>

<style>
  .hero {
    position: relative;
    /* svh, the height that does not move when the mobile URL bar collapses,
       and the height the viewport already has at first paint. dvh tracked the
       bar instead, so the hero re-laid out mid-scroll: the centred copy shifted
       and the bottom anchored scroll cue slid with it. */
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-bg);

    /* MagicUI DotPattern defaults: 16px cell, 1px dot at (1, 1). */
    --hero-dot-gap: 16px;
    --hero-dot-size: 1px;
    --hero-dot-color: oklch(70% 0.004 260 / 80%);
    /* The fade frames the copy, so it is a variable: the copy arrangement
       changes at the breakpoint and the fade has to move with it. Here the
       copy is a 38rem column against the left edge. */
    --hero-dot-mask: ellipse 85% 70% at 35% 50%;
  }

  /* Dots sit at z-index 0: under the knot canvas (1) and the copy (2).
     Their own element so the radial fade can be masked without touching
     either. DotPattern is a React island that renders an SVG <pattern> of
     circles; the same result needs no component and no dependency here. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle at var(--hero-dot-size) var(--hero-dot-size),
      var(--hero-dot-color) var(--hero-dot-size),
      transparent 0
    );
    background-size: var(--hero-dot-gap) var(--hero-dot-gap);
    mask-image: radial-gradient(
      var(--hero-dot-mask),
      #000 30%,
      transparent 100%
    );
  }

  .hero-content {
    z-index: 2;
  }

  .hero-content {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    left: clamp(1.5rem, 5vw, 5rem);
    right: 10vw;
    max-width: 38rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 600;
    font-optical-sizing: none;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    text-wrap: balance;
    line-height: 0.96;
    margin: 0;
    animation: hero-in 0.9s 0.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 500;
    color: var(--color-muted);
    line-height: 1.5;
    margin-top: 1.5rem;
    max-width: 32rem;
    animation: hero-in 0.9s 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 2rem;
    margin-top: 2rem;
    animation: hero-in 0.9s 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---- FAQ ---- */
  .faq {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding: var(--section-y) var(--section-x);
    background: var(--color-bg);
  }

  .faq-heading {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.6vw, 3rem);
    font-weight: 600;
    font-optical-sizing: none;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    line-height: 1.1;
    text-wrap: balance;
    margin-top: 0;
  }

  .faq-list {
    border-top: 1px solid var(--color-border);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-question {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    color: var(--color-ink);
    transition: color 150ms ease;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) {
    .faq-question:hover {
      color: var(--color-accent);
    }
  }

  .faq-question:focus-visible {
    outline-offset: -2px;
  }

  /*
   * A drawn plus, not a glyph: the text "+" sat on the font's math axis and
   * read a pixel high against the question. Opening turns the vertical bar
   * flat onto the horizontal one, so the plus becomes a minus by one shape
   * moving rather than one icon swapping for another.
   */
  .faq-icon {
    flex-shrink: 0;
    align-self: center;
    fill: var(--color-muted);
    transition: fill 150ms ease;
  }

  .faq-icon-v {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-item[open] .faq-icon-v {
    transform: rotate(90deg);
  }

  @media (hover: hover) {
    .faq-question:hover .faq-icon {
      fill: currentColor;
    }
  }

  /*
   * The answer opens to its height instead of appearing at it. Browsers
   * without ::details-content keep the instant open plus the fade below, so
   * this is enhancement only. Closing runs faster than opening.
   */
  .faq-item {
    interpolate-size: allow-keywords;
  }

  .faq-item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 220ms cubic-bezier(0.16, 1, 0.3, 1),
      content-visibility 220ms allow-discrete;
  }

  .faq-item[open]::details-content {
    block-size: auto;
    transition-duration: 320ms;
  }

  .faq-answer {
    overflow: hidden;
    padding: 0 2.75rem 1.5rem 0;
  }

  .faq-answer p {
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 55ch;
  }

  .faq-item[open] .faq-answer {
    animation: faq-open 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 767px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }

    .faq-icon,
    .faq-icon-v {
      transition: none;
    }

    /* Its own rule: a list holding a pseudo-element the browser does not
       know is dropped whole, which took the icon rule above down with it. */
    .faq-item::details-content {
      transition: none;
    }
  }

  /* ---- Selected work ---- */
  .work {
    padding: var(--section-y) var(--section-x);
    background: var(--color-bg);
  }

  .work-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  .work-heading {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.6vw, 3rem);
    font-weight: 600;
    font-optical-sizing: none;
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    color: var(--color-ink);
  }

  /*
   * Twelve columns, split 7 / 5 on the first row and 5 / 7 on the second, with
   * the narrow tile of the first row dropped below its neighbour. Two equal
   * columns would read as a card grid; the offset makes it a hung set of
   * plates. The second row stays level so the section ends on a straight edge.
   */
  .work-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: clamp(3rem, 8vh, 5.5rem);
  }

  .work-item:nth-child(4n + 1),
  .work-item:nth-child(4n) {
    grid-column: span 7;
  }

  .work-item:nth-child(4n + 2),
  .work-item:nth-child(4n + 3) {
    grid-column: span 5;
  }

  .work-item:nth-child(4n + 2) {
    margin-top: clamp(3rem, 12vh, 8rem);
  }

  .work-item a {
    display: block;
  }

  .work-item a:focus-visible {
    outline-offset: 6px;
  }

  .work-frame {
    overflow: hidden;
    aspect-ratio: 5 / 3;
    background: var(--color-surface);
    /* A ring rather than a border, so the frame stays exactly 5:3 and a light
       screenshot still has an edge against the off white ground. */
    box-shadow: 0 0 0 1px oklch(10% 0.005 260 / 10%);
  }

  .work-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .work-item a:hover .work-frame img {
      transform: scale(1.025);
    }

    .work-item a:hover .work-title {
      color: var(--color-accent);
    }
  }

  /*
   * Fixed to the viewport and moved by transform alone. The inner pill
   * carries the enter and exit (scale from 0.95, never 0), the outer layer
   * carries position, so the two never fight over one transform.
   */
  .work-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    pointer-events: none;
    user-select: none;
  }

  .work-cursor-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    margin: 14px 0 0 14px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 2px 12px var(--color-overlay);
    opacity: 0;
    transform: scale(0.95);
    transform-origin: top left;
    transition:
      opacity 120ms ease-out,
      transform 120ms ease-out;
  }

  .work-cursor[data-visible] .work-cursor-pill {
    opacity: 1;
    transform: none;
