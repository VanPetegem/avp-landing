---
import BaseLayout from '../layouts/BaseLayout.astro'
import BigTypeRoll from '../components/BigTypeRoll'
import HeroKnot from '../components/HeroKnot.astro'
import { projects } from '../data/projects'

// A video project shows its poster here: the home page is a list of stills,
// and four autoplaying encodes would cost more than the section is worth.
const work = projects.slice(0, 4).map((project) => ({
  slug: project.slug,
  title: project.title,
  client: project.client,
  year: project.year,
  image: project.video?.poster ?? project.images[0],
}))

const steps = [
  {
    title: 'Map',
    body: 'I start inside the workflow: the spreadsheet someone updates by hand, the approval that lives in an inbox. The tool gets designed around how your team already works.',
  },
  {
    title: 'Design',
    body: 'Internal tools people actually want to open. Status visible at a glance, forms that adapt to the case, and no manual required to use any of it.',
  },
  {
    title: 'Build',
    body: 'Wired into the systems you already pay for: accounting, e-signing, email, webhooks. Work moves itself forward instead of waiting for someone to forward it.',
  },
  {
    title: 'Run',
    body: 'I host it, watch it, and keep automating. Every release after launch removes another manual step.',
  },
]

const faqs = [
  {
    q: 'What kind of projects do you take on?',
    a: 'Mostly internal tools and workflow automation: expense pipelines, approval flows, dashboards. The software your team uses every day but your customers never see. I also build customer facing products end to end when the fit is right.',
  },
  {
    q: 'Can you connect the tools we already use?',
    a: 'Yes, that is usually the whole point. Past projects have talked to accounting software, e-signature services, email, and plain webhooks. If it has an API, or even just an export button, it can join the workflow.',
  },
  {
    q: 'What does a project cost?',
    a: 'I quote a fixed price for a defined scope after we have mapped what the work involves. If the scope grows, we agree on a new price before I build more. You will never find the surprise on an invoice.',
  },
  {
    q: 'How long until something usable?',
    a: 'Weeks, not quarters. I ship a small working version early, your team uses it, and we improve from there.',
  },
  {
    q: 'How much of our time do you need?',
    a: 'A kickoff where I watch how the work is done today, then a short weekly check-in. The people doing the actual work teach me more than any requirements document.',
  },
  {
    q: 'Who runs it after launch?',
    a: 'I do. Hosting, monitoring, fixes, and further automation. If you want to take it in house later, you get the code and a proper handover.',
  },
  {
    q: 'How do we find out if it is a fit?',
    a: 'Send a message through the <a href="/contact">contact page</a> and describe the workflow that annoys you most. If I can help, I will tell you how. If I cannot, I will say so.',
  },
]

---
<BaseLayout title="AVP Software">
  <section class="hero">
    <HeroKnot />

    <div class="hero-content">
      <h1 class="hero-title">AVP Software</h1>
      <p class="hero-tagline">
        A small studio that designs and builds software end to end: interface,
        product, and the infrastructure underneath.
      </p>
      <div class="hero-actions">
        <a class="text-link" href="/contact">
          <span>Get in touch</span>
          <span class="text-link-arrow" aria-hidden="true">&#8594;</span>
        </a>
        <a class="text-link" data-quiet href="/work">
          <span>See the work</span>
        </a>
      </div>
    </div>
  </section>

  <section class="process" id="process">
    <header class="process-head" data-reveal>
      <span class="page-label">Process</span>
      <h2 class="process-heading">
        Most projects start with an idea. Mine start with your team's most
        annoying Tuesday.
      </h2>
    </header>
    <ol class="process-steps">
      {steps.map((step, i) => (
        <li class="process-step" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <span class="process-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="process-text">
            <h3 class="process-title">{step.title}</h3>
            <p class="process-body">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="work" aria-labelledby="work-heading">
    <header class="work-head" data-reveal>
      <h2 class="work-heading" id="work-heading">Selected work</h2>
      <a class="text-link" href="/work">
        <span>All work</span>
        <span class="text-link-arrow" aria-hidden="true">&#8594;</span>
      </a>
    </header>
    <ul class="work-grid">
      {work.map((item, i) => (
        <li class="work-item" data-reveal style={`--reveal-delay: ${(i % 2) * 90}ms`}>
          <a href={`/work/${item.slug}`}>
            <div class="work-frame">
              <img
                src={item.image}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="work-meta">
              <h3 class="work-title">{item.title}</h3>
              <span class="work-client">{item.client}, {item.year}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="bigtype" aria-hidden="true">
    <div class="bigtype-line" data-speed="-0.35">
      <div class="bigtype-shift" data-bigtype-shift>
        <BigTypeRoll text="DESIGN BUILD" client:media="(hover: hover) and (pointer: fine)" />
      </div>
    </div>
    <div class="bigtype-line" data-speed="0.35">
      <div class="bigtype-shift" data-bigtype-shift>
        <BigTypeRoll text="AUTOMATE RUN" center client:media="(hover: hover) and (pointer: fine)" />
      </div>
    </div>
  </section>

  <section class="faq">
    <header class="faq-head" data-reveal>
      <h2 class="faq-heading">The questions clients ask first.</h2>
    </header>
    <div class="faq-list">
      {faqs.map((item, i) => (
        <details class="faq-item" name="faq" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
          <summary class="faq-question">
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p set:html={item.a} />
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import { calculateBigtypeShift } from '../scripts/bigtype-motion.mjs'

  function armBigtype() {
    const lines = Array.from(
      document.querySelectorAll<HTMLElement>('.bigtype-line')
    )
    if (!lines.length) return
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return

    let ticking = false
    const update = () => {
      ticking = false
      const vh = innerHeight
      for (const line of lines) {
        const rect = line.getBoundingClientRect()
        const lineCenter = rect.top + rect.height / 2
        const speed = parseFloat(line.dataset.speed || '0')
        const shiftTarget = line.querySelector<HTMLElement>('[data-bigtype-shift]')
        if (!shiftTarget) continue
        const shift = calculateBigtypeShift(
          lineCenter,
          vh,
          innerWidth,
          speed,
          shiftTarget.getBoundingClientRect().width
        )
        shiftTarget.style.setProperty('--shift', `${shift}px`)
      }
    }
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(update)
    }

    addEventListener('scroll', onScroll, { passive: true })
    // A resize changes the slack, so a shift parked from the last scroll can
    // outgrow it. Re-clamp on resize rather than wait for the next scroll.
    addEventListener('resize', onScroll, { passive: true })
    update()
  }

  armBigtype()
  document.addEventListener('astro:page-load', armBigtype)
</script>

<style>
  .hero {
    position: relative;
    /* svh, the height that does not move when the mobile URL bar collapses,
       and the height the viewport already has at first paint. dvh tracked the
       bar instead, so the hero re-laid out mid-scroll: the centred copy shifted
       and the bottom anchored scroll cue slid with it. */
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-bg);

    /* MagicUI DotPattern defaults: 16px cell, 1px dot at (1, 1). */
    --hero-dot-gap: 16px;
    --hero-dot-size: 1px;
    --hero-dot-color: oklch(70% 0.004 260 / 80%);
    /* The fade frames the copy, so it is a variable: the copy arrangement
       changes at the breakpoint and the fade has to move with it. Here the
       copy is a 38rem column against the left edge. */
    --hero-dot-mask: ellipse 85% 70% at 35% 50%;
  }

  /* Dots sit at z-index 0: under the knot canvas (1) and the copy (2).
     Their own element so the radial fade can be masked without touching
     either. DotPattern is a React island that renders an SVG <pattern> of
     circles; the same result needs no component and no dependency here. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle at var(--hero-dot-size) var(--hero-dot-size),
      var(--hero-dot-color) var(--hero-dot-size),
      transparent 0
    );
    background-size: var(--hero-dot-gap) var(--hero-dot-gap);
    mask-image: radial-gradient(
      var(--hero-dot-mask),
      #000 30%,
      transparent 100%
    );
  }

  .hero-content {
    z-index: 2;
  }

  .hero-content {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    left: clamp(1.5rem, 5vw, 5rem);
    right: 10vw;
    max-width: 38rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 600;
    font-optical-sizing: none;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    text-wrap: balance;
    line-height: 0.96;
    margin: 0;
    animation: hero-in 0.9s 0.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 500;
    color: var(--color-muted);
    line-height: 1.5;
    margin-top: 1.5rem;
    max-width: 32rem;
    animation: hero-in 0.9s 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 2rem;
    margin-top: 2rem;
    animation: hero-in 0.9s 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---- FAQ ---- */
  .faq {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding: var(--section-y) var(--section-x);
    background: var(--color-bg);
  }

  .faq-heading {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.6vw, 3rem);
    font-weight: 600;
    font-optical-sizing: none;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    line-height: 1.1;
    text-wrap: balance;
    margin-top: 0;
  }

  .faq-list {
    border-top: 1px solid var(--color-border);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-question {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    color: var(--color-ink);
    transition: color 200ms;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: var(--color-accent);
  }

  .faq-question:focus-visible {
    outline-offset: -2px;
  }

  .faq-icon {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1;
    color: var(--color-muted);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    overflow: hidden;
    padding: 0 2.75rem 1.5rem 0;
  }

  .faq-answer p {
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 55ch;
  }

  .faq-item[open] .faq-answer {
    animation: faq-open 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 767px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }

    .faq-icon {
      transition: none;
    }
  }

  /* ---- Selected work ---- */
  .work {
    padding: var(--section-y) var(--section-x);
    background: var(--color-bg);
  }

  .work-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  .work-heading {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.6vw, 3rem);
    font-weight: 600;
    font-optical-sizing: none;
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    color: var(--color-ink);
  }

  /*
   * Twelve columns, split 7 / 5 on the first row and 5 / 7 on the second, with
   * the narrow tile of each row dropped below its neighbour. Two equal columns
   * would read as a card grid; the offset makes it a hung set of plates.
   */
  .work-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: clamp(3rem, 8vh, 5.5rem);
  }

  .work-item:nth-child(4n + 1),
  .work-item:nth-child(4n) {
    grid-column: span 7;
  }

  .work-item:nth-child(4n + 2),
  .work-item:nth-child(4n + 3) {
    grid-column: span 5;
  }

  .work-item:nth-child(4n + 2) {
    margin-top: clamp(3rem, 12vh, 8rem);
  }

  .work-item a {
    display: block;
  }

  .work-item a:focus-visible {
    outline-offset: 6px;
  }

  .work-frame {
    overflow: hidden;
    aspect-ratio: 5 / 3;
    background: var(--color-surface);
    /* A ring rather than a border, so the frame stays exactly 5:3 and a light
       screenshot still has an edge against the off white ground. */
    box-shadow: 0 0 0 1px oklch(10% 0.005 260 / 10%);
  }

  .work-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .work-item a:hover .work-frame img {
      transform: scale(1.025);
    }

    .work-item a:hover .work-title {
      color: var(--color-accent);
    }
  }

  .work-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1rem;
  }

  .work-title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--color-ink);
    transition: color 200ms;
  }

  .work-client {
    flex-shrink: 0;
    font-size: 0.875rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 767px) {
    .work-grid {
      grid-template-columns: 1fr;
      row-gap: 2.5rem;
    }

    .work-item:nth-child(n) {
      grid-column: auto;
      margin-top: 0;
    }

    .work-meta {
      flex-direction: column;
      gap: 0.15rem;
    }
  }

  /* ---- Big type ---- */
  .bigtype {
    overflow: hidden;
    padding: clamp(3rem, 7vh, 5rem) 0;
    background: var(--color-bg);
  }

  :global(.bigtype-line) {
    display: flex;
    justify-content: center;
  }

  :global(.bigtype-shift) {
    transform: translateX(var(--shift, 0px));
    will-change: transform;
  }

  /*
   * The roll stacks an incoming copy of the word over the base one and relies
   * on Framer's `initial` variant to hold it below the mask. That variant is
   * not emitted server-side, so an unhydrated island paints both copies on top
   * of each other. Since the islands deliberately never hydrate on touch, that
   * is the permanent phone rendering: park the incoming layer in CSS instead.
   * Framer writes inline transforms on these spans once it hydrates, which win
   * over this rule.
   */
  :global(.bigtype-roll [data-roll-layer='incoming'] > span) {
    transform: translateY(100%);
  }

  :global(.bigtype-roll) {
    font-family: var(--font-display);
    /*
     * Sized against the wider line: AUTOMATE RUN measures 8.49x its font size
     * in Bodoni Moda 600 with per-character inline-blocks, so 90vw / 8.49
     * lands it at 90% of the viewport, leaving a 5% gutter each side for the
     * scroll drift to spend. The old 4.5rem floor outran the viewport below
     * ~450px and held the line at its desktop width on a phone, which is what
     * clipped both ends; this floor only engages under 264px, so the viewport
     * term governs everywhere a real phone reaches and the line cannot
     * overflow. The ceiling is set so it takes over at the same 90% span.
     */
    font-size: clamp(1.75rem, 10.6vw, 13rem);
    font-weight: 600;
    font-optical-sizing: none;
    line-height: 0.95;
    white-space: nowrap;
    color: var(--color-ink);
  }

  /* ---- Process ---- */
  .process {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding: var(--section-y) var(--section-x);
    background: var(--color-bg);
  }

  .process-head {
    position: sticky;
    top: clamp(5rem, 15vh, 9rem);
  }

  .process-heading {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.6vw, 3rem);
    font-weight: 600;
    font-optical-sizing: none;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    line-height: 1.1;
    text-wrap: balance;
    margin-top: 0.25rem;
  }

  .process-steps {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .process-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    padding: clamp(2rem, 5vh, 3.5rem) 0;
    border-bottom: 1px solid var(--color-border);
  }

  /*
   * The number keeps its own column only while there is width to spare. At
   * 390px the 5.5rem column plus the gap left about 270px for the body copy,
   * so below 30rem the number sits above its step instead of beside it.
   */
  @media (max-width: 30rem) {
    .process-step {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  .process-num {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 600;
    font-optical-sizing: none;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 0.9;
    color: var(--color-ink);
  }

  /* Sentence case at body size, not another tracked uppercase label: the
     page already spends that voice on the section kicker above. */
  .process-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }

  .process-body {
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 42ch;
  }

  @media (max-width: 767px) {
    .process {
      grid-template-columns: 1fr;
    }

    .process-head {
      position: static;
    }
  }

  @media (max-width: 767px) {
    .hero {
      /* The copy below runs gutter to gutter and stays vertically centred, so
         the fade centres with it and flattens to the band it occupies. The
         desktop 35% offset put the bright side of the fade beside copy that no
         longer sits there. Wider than the viewport on purpose: the dots reach
         both gutters and only fade out past them, since on touch, where the
         knot no longer renders, they are the hero's only texture. */
      --hero-dot-mask: ellipse 120% 42% at 50% 50%;
    }

    .hero-content {
      left: 1.5rem;
      right: 1.5rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-tagline,
    .hero-actions {
      animation: none;
    }

    .work-frame img {
      transition: none;
    }
  }
</style>
