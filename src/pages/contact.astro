---
import BaseLayout from '../layouts/BaseLayout.astro'

const contacts = [
  {
    label: 'Email',
    value: 'hello@avp.software',
    href: 'mailto:hello@avp.software',
    external: false,
  },
  {
    label: 'LinkedIn',
    value: 'Arthur Van Petegem',
    href: 'https://www.linkedin.com/in/arthur-van-petegem-7b72b1323/',
    external: true,
  },
  {
    label: 'GitHub',
    value: 'VanPetegem',
    href: 'https://github.com/VanPetegem',
    external: true,
  },
]
---
<BaseLayout title="Contact | AVP Software" footerCta={false}>
  <main class="page-split">
    <header class="page-split-head">
      <span class="page-label">Contact</span>
      <h1 class="page-heading">Get in touch</h1>
    </header>

    <div>
      <p class="page-lead">
        Describe the workflow that costs your team the most time. If I can
        help, I will tell you how. If I cannot, I will say so.
      </p>

    <div class="contact-rows">
      {contacts.map(({ label, value, href, external }) => (
        <a
          href={href}
          class="contact-row"
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          <span class="contact-label label">{label}</span>
          <span class="contact-value">{value}</span>
          <svg
            class="contact-arrow"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 13L13 3M13 3H6M13 3V10"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      ))}
    </div>
    </div>
  </main>
</BaseLayout>

<style>
  .contact-rows {
    display: flex;
    flex-direction: column;
    margin-top: clamp(2.5rem, 7vh, 4rem);
  }

  .contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }

  .contact-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  /* The row itself holds still: sliding a full-width row pushed its own
     hairline out past the column. The value and the arrow carry the hover. */
  .contact-row:hover .contact-value {
    color: var(--color-accent);
  }

  .contact-row:hover .contact-arrow {
    transform: translate(3px, -3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-arrow {
      transition: none;
    }
  }

  .contact-label {
    width: 5rem;
    flex-shrink: 0;
  }

  .contact-value {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    letter-spacing: -0.01em;
    color: var(--color-ink);
    flex: 1;
    padding: 0 1rem;
    /* An address is one unbreakable word; on a 320px screen it has to wrap. */
    overflow-wrap: anywhere;
    transition: color 200ms;
  }

  .contact-arrow {
    color: var(--color-muted);
    flex-shrink: 0;
    transition: color 200ms, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-row:hover .contact-arrow {
    color: var(--color-accent);
  }

</style>
